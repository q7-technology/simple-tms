# Copy to .env and fill in. Nothing here is committed.

# Postgres (used by the db and api containers)
POSTGRES_DB=tms
POSTGRES_USER=tms
POSTGRES_PASSWORD=change-me
# Host port the database is published on (127.0.0.1 only). 5434 sits beside
# Simple WMS's 5433. The tests expect POSTGRES_PASSWORD=tms-dev on this port
# unless TEST_DATABASE_URL says otherwise.
POSTGRES_PORT=5434

# API
# Signs session tokens. At least 32 random characters: make one with
#   openssl rand -hex 32
# The API refuses to start with anything shorter, or with this example value.
TMS_SECRET_KEY=change-me-to-a-long-random-string
# Host port the API is published on, for local work and health checks.
# Caddy is still the only door from outside. Not 8021: a Mac's own ftp-proxy
# holds that one.
TMS_API_PORT=8022

# Simple WMS (optional: Simple TMS works without it)
# The secret of the Simple TMS subscriber in Simple WMS, 16 to 128
# characters (openssl rand -hex 32). Events signed with anything else are
# refused; shorter than 16 counts as not set.
TMS_WMS_WEBHOOK_SECRET=
# Where Simple WMS's API is, and a WMS API key with the tasks:read and
# tasks:write scopes: tasks:read to read a packed delivery's ship-to,
# tasks:write to tell Simple WMS it shipped when its run departs.
TMS_WMS_URL=
TMS_WMS_API_KEY=

# Platen (optional: without it, run sheets are not printed)
# Its job intake, e.g. https://platen.example.com/intake/jobs, and an
# operator key from Platen's People > Keys. Give that Platen key a callback to
# this API (https://<tms>) with a Simple TMS key made by
#   docker compose exec api tms create-api-key --name platen --scopes printing:write
# so Platen can say each run sheet printed.
TMS_PLATEN_URL=
TMS_PLATEN_KEY=
# The Platen printer run sheets go to: its id or its name.
TMS_RUN_SHEET_PRINTER=dispatch

# Live location (optional settings)
# Positions, and the position kept with each proof of delivery, are deleted
# this many days after they were taken. Check what your state's workplace
# surveillance law asks of you (e.g. the NSW Workplace Surveillance Act).
TMS_POSITION_RETENTION_DAYS=90
# Map tiles for the desktop's "Where is it". Empty: each truck's position is
# listed without a map. A raster tile address with {z}, {x} and {y}: a tile
# provider's, with its key (the browser sees the key: restrict it to your
# domain at the provider), or a tile server of your own. Not
# tile.openstreetmap.org: its policy rules out apps. See "Map tiles" in the
# README.
TMS_MAP_TILE_URL=
TMS_MAP_ATTRIBUTION=
# The provider's origin (https://host, no path), let into the desktop's
# Content-Security-Policy by Caddy. Empty for tiles on this server.
TMS_MAP_TILE_ORIGIN=
# ETAs: the minutes a stop is taken to need until the driver has done one.
TMS_ETA_MINUTES_PER_STOP=20

# Caddy: the public host name. "localhost" gives a self-signed local cert.
TMS_DOMAIN=localhost
# Host ports Caddy listens on. Keep 80 and 443 for a real domain: Let's
# Encrypt only checks those. Other ports (say 8180 and 8543 beside Simple
# WMS's Caddy) are for local work and a LAN only; see "Production on a real
# domain" in the README for running beside Simple WMS.
TMS_HTTP_PORT=80
TMS_HTTPS_PORT=443
