{
	# Listen on the host's ports (TMS_HTTP_PORT, TMS_HTTPS_PORT), so Simple TMS
	# can run beside Simple WMS's Caddy, which already has 80 and 443.
	http_port {$TMS_HTTP_PORT:80}
	https_port {$TMS_HTTPS_PORT:443}
	# Caddy's own redirect leaves the port out, so the one below names it.
	auto_https disable_redirects
}

http://{$TMS_DOMAIN} {
	redir https://{host}:{$TMS_HTTPS_PORT:443}{uri} 308
}

{$TMS_DOMAIN} {
	encode gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
	}

	# The API is the only door.
	handle /v1/* {
		reverse_proxy api:8000
	}
	handle /docs* {
		reverse_proxy api:8000
	}
	handle /openapi.json {
		reverse_proxy api:8000
	}

	# The driver app (build step 3): a PWA under /driver/. Its pictures are
	# blob: URLs of photos taken on the phone; nothing else comes from outside.
	@driverbare path /driver
	redir @driverbare /driver/ 308
	handle_path /driver/* {
		header Content-Security-Policy "default-src 'self'; img-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		# checked on every launch, so a new build reaches the phones
		header /sw.js Cache-Control "no-cache"
		root * /srv/driver
		try_files {path} /index.html
		file_server
	}

	# The desktop app (build step 2).
	handle {
		# Only the desktop: the API's /docs page loads its scripts from a CDN.
		# The build has no inline scripts or styles, and its fonts are its own.
		header Content-Security-Policy "default-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		root * /srv/desktop
		try_files {path} /index.html
		file_server
	}
}
